{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "patientPortal/Routes": [
        "patientPortal/src/app/remote-entry/entry.routes.ts"
      ],
      "doctorPortal/Routes": [
        "doctorPortal/src/app/remote-entry/entry.routes.ts"
      ],
      "adminPortal/Routes": [
        "adminPortal/src/app/remote-entry/entry.routes.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
