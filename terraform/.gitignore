# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive or generated files
*.tfvars
*.tfvars.json
override.tf
override.tf.json
_override.tf
_override.tf.json

# .terraform.lock.hcl is usually committed, but let's keep it simple for now
